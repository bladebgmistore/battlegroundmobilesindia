# ============================================================================
#  Battleground Mobile India Store — environment variables
#  Copy to .env.local for local dev, or paste into your host's dashboard
#  (Vercel → Settings → Environment Variables, Netlify → Site configuration).
#  NEVER commit the real values.
# ============================================================================

# ── Database — Multi-DB with automatic failover ────────────────────────────
# The app implements a unified client (src/db/index.ts + src/lib/db.ts) that:
#   • Always queries PRIMARY first (BGMISTORE_* keys).
#   • On connection error / timeout / Neon quota or monthly-limit, automatically
#     retries the SAME query on SECONDARY (DATABASE2_* keys) — the site never
#     crashes because one Neon project hit its free-tier limit.
#
# Pooled vs unpooled:
#   • Pooled  (pgbouncer) → for serverless runtime (BGMISTORE_POSTGRES_PRISMA_URL
#     / BGMISTORE_POSTGRES_URL / BGMISTORE_DATABASE_URL).
#   • Unpooled (direct)   → for drizzle-kit migrations & admin bootstrap
#     (BGMISTORE_DATABASE_URL_UNPOOLED / BGMISTORE_POSTGRES_URL_NON_POOLING).
# Drizzle Kit always prefers the unpooled URL; the runtime prefers pooled.
#
# Vercel Postgres / Neon integration sets the BGMISTORE_* and DATABASE2_* vars
# automatically when you add two Postgres stores — no code change needed.
# For single-DB or local dev you may still use the unprefixed DATABASE_URL.

# ---- PRIMARY DATABASE (BGMISTORE_* keys — required) -------------------------
BGMISTORE_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
BGMISTORE_DATABASE_URL_UNPOOLED=postgresql://user:password@host.neon.tech/dbname?sslmode=require
BGMISTORE_POSTGRES_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
BGMISTORE_POSTGRES_PRISMA_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require&pgbouncer=true
BGMISTORE_POSTGRES_URL_NON_POOLING=postgresql://user:password@host.neon.tech/dbname?sslmode=require
BGMISTORE_POSTGRES_USER=user
BGMISTORE_POSTGRES_HOST=host.neon.tech
BGMISTORE_POSTGRES_PASSWORD=password
BGMISTORE_POSTGRES_DATABASE=dbname
BGMISTORE_NEON_PROJECT_ID=neon-project-id

# ---- SECONDARY / BACKUP DATABASE (DATABASE2_* keys — optional but recommended)
DATABASE2_DATABASE_URL=postgresql://user2:password2@host2.neon.tech/dbname2?sslmode=require
DATABASE2_DATABASE_URL_UNPOOLED=postgresql://user2:password2@host2.neon.tech/dbname2?sslmode=require
DATABASE2_POSTGRES_URL=postgresql://user2:password2@host2.neon.tech/dbname2?sslmode=require
DATABASE2_POSTGRES_PRISMA_URL=postgresql://user2:password2@host2.neon.tech/dbname2?sslmode=require&pgbouncer=true
DATABASE2_POSTGRES_URL_NON_POOLING=postgresql://user2:password2@host2.neon.tech/dbname2?sslmode=require
DATABASE2_POSTGRES_USER=user2
DATABASE2_POSTGRES_HOST=host2.neon.tech
DATABASE2_POSTGRES_PASSWORD=password2
DATABASE2_POSTGRES_DATABASE=dbname2
DATABASE2_NEON_PROJECT_ID=neon-project-id-2

# ---- Legacy single-DB fallback (still honoured for local dev) ---------------
# If BGMISTORE_* is not set, the app falls back to DATABASE_URL so existing
# installs and local previews keep working without changes.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── Google OAuth 2.0 (Google Cloud Console → APIs & Services → Credentials) ──
GOOGLE_CLIENT_ID=822938602122-d99qjh37o9gl4hu332ijrdjjjvum4f5p.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
# Must exactly match an Authorized redirect URI on this OAuth client.
GOOGLE_REDIRECT_URI=https://battlegroundmobilesindia.shop/auth/google/callback

# ── Session signing key — generate with: openssl rand -base64 32 ────────────
AUTH_SECRET=replace-with-a-long-random-string

# ── Role based access control ───────────────────────────────────────────────
# Comma separated. These Google accounts get the full-access `owner` role.
# Extra admins / managers / moderators are added from the website itself:
# Admin Panel → Team & Roles (stored in the staff_members table — no env change
# or redeploy needed, and access can be suspended/removed instantly).
OWNER_EMAIL=manavjeph800@gmail.com

# ── Meta (Facebook) Pixel ───────────────────────────────────────────────────
# Public by design — it ships inside the browser bundle. Leave it empty in any
# environment where you don't want tracking (the <MetaPixel /> component then
# renders nothing). Read by src/components/meta-pixel.tsx + src/lib/fpixel.ts.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=4056208531176598

# ── Optional: transactional email (already used by the store) ───────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ── Optional: Telegram instant alerts to the admin's phone ──────────────────
# New orders + new support tickets / customer replies are pushed to the
# admin's Telegram via the Bot API (HTML bold formatting, sent async after
# the response so checkout/chat is never slowed down).
# TELEGRAM_BOT_TOKEN comes from @BotFather; ADMIN_CHAT_ID is the admin's chat
# id (get it from @userinfobot). The values below are the store's live bot —
# override them per environment and never share the token publicly.
TELEGRAM_BOT_TOKEN=8870123992:AAG7TMwI04Rm35yNTDb9Ri0io1evlvqH21M
ADMIN_CHAT_ID=6109375681
