# ============================================================================
#  Battleground Mobile India Store — environment variables
#  Copy to .env.local for local dev, or paste into your host's dashboard
#  (Vercel → Settings → Environment Variables, Netlify → Site configuration).
#  NEVER commit the real values.
# ============================================================================

# ── Database (Neon / any PostgreSQL) ────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── Firebase Web SDK — Phone Auth (+91 mobile OTP) ──────────────────────────
# Firebase Console → Project settings → Your apps → Web app → SDK setup.
# These values are public by design: they ship inside the browser bundle.
# Read by src/lib/firebase.ts (client) and src/lib/firebase-verify.ts (server).
#
# One-time setup in the Firebase console:
#   1. Authentication → Sign-in method → enable **Phone**.
#   2. Authentication → Settings → Authorised domains → add every domain the
#      site is served from (production domain, *.vercel.app / *.netlify.app and
#      localhost). Phone sign-in is refused on unauthorised domains.
#   3. (Optional) Authentication → Templates → SMS → set the sender language to
#      Hindi/English for Indian numbers.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBo2oq92M_Ld6OGIWUWUWUwVd9q5GnW3oKNY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=battlegroundmobileindias-f8e2f.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=battlegroundmobileindias-f8e2f
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=battlegroundmobileindias-f8e2f.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=982171987292
NEXT_PUBLIC_FIREBASE_APP_ID=1:982171987292:web:4f52d95624d271caa02599
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-WKTZZ2KHYH

# Phone-token verification policy for POST /api/auth/phone.
#   strict → the Firebase ID token is confirmed with Google's Identity Toolkit
#            (default in production — recommend leaving it unset there)
#   jwt    → validate the token's claims only; use this for offline dev /
#            preview sandboxes that cannot reach googleapis.com
# FIREBASE_PHONE_VERIFY=jwt

# ── Google OAuth 2.0 (Google Cloud Console → APIs & Services → Credentials) ──
GOOGLE_CLIENT_ID=822938602122-d99qjh37o9gl4hu332ijrdjjjvum4f5p.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
# Must match an "Authorised redirect URI" on the OAuth client exactly.
GOOGLE_REDIRECT_URI=https://battlegroundmobilesindia.shop/auth/google/callback

# ── Session signing key — generate with: openssl rand -base64 32 ────────────
AUTH_SECRET=replace-with-a-long-random-string

# ── Role based access control ───────────────────────────────────────────────
# Comma separated. These Google accounts get the full-access `owner` role.
# Extra admins / managers / moderators are added from the website itself:
# Admin Panel → Team & Roles (stored in the staff_members table — no env change
# or redeploy needed, and access can be suspended/removed instantly).
OWNER_EMAIL=manavjeph800@gmail.com

# ── Meta (Facebook) Pixel ───────────────────────────────────────────────────
# Public by design — it ships inside the browser bundle. Leave it empty in any
# environment where you don't want tracking (the <MetaPixel /> component then
# renders nothing). Read by src/components/meta-pixel.tsx + src/lib/fpixel.ts.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=4056208531176598

# ── Optional: transactional email (already used by the store) ───────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ── Optional: Telegram instant alerts to the admin's phone ──────────────────
# New orders + new support tickets / customer replies are pushed to the
# admin's Telegram via the Bot API (HTML bold formatting, sent async after
# the response so checkout/chat is never slowed down).
# TELEGRAM_BOT_TOKEN comes from @BotFather; ADMIN_CHAT_ID is the admin's chat
# id (get it from @userinfobot). The values below are the store's live bot —
# override them per environment and never share the token publicly.
TELEGRAM_BOT_TOKEN=8870123992:AAG7TMwI04Rm35yNTDb9Ri0io1evlvqH21M
ADMIN_CHAT_ID=6109375681
