# ============================================================================
#  Battleground Mobile India Store — environment variables
#  Copy to .env.local for local dev, or paste into your host's dashboard
#  (Vercel → Settings → Environment Variables, Netlify → Site configuration).
#  NEVER commit the real values.
#
#  Every variable below is resolved in ONE place: `src/lib/env.ts`.
#  The Vercel Postgres/Neon integration keys are all prefixed `BGMISTORE_*`.
# ============================================================================

# ── 1. DATABASE (BGMISTORE_* keys) ──────────────────────────────────────────
# POOLED connection string — used by the running app (serverless-safe).
BGMISTORE_DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# DIRECT (non-pooled) connection string — used by migrations / DDL only.
# Required for `npx drizzle-kit push` (PgBouncer transaction mode cannot run
# CREATE TABLE / ALTER TABLE). Optional for the app itself.
BGMISTORE_DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Vercel also injects these aliases for the same database. They are used as
# fallbacks (in the order below) when the two keys above are absent:
#   BGMISTORE_POSTGRES_PRISMA_URL   → pooled, Prisma-flavoured params
#   BGMISTORE_POSTGRES_URL          → pooled
#   BGMISTORE_POSTGRES_URL_NON_POOLING → direct
# BGMISTORE_POSTGRES_PRISMA_URL=
# BGMISTORE_POSTGRES_URL=
# BGMISTORE_POSTGRES_URL_NON_POOLING=

# Discrete credentials — only read when no full connection string is set
# (the app then assembles one from these parts).
# BGMISTORE_POSTGRES_USER=
# BGMISTORE_POSTGRES_PASSWORD=
# BGMISTORE_POSTGRES_HOST=
# BGMISTORE_POSTGRES_DATABASE=
# BGMISTORE_PGUSER=
# BGMISTORE_PGPASSWORD=
# BGMISTORE_PGDATABASE=
# BGMISTORE_PGHOST=
# BGMISTORE_PGHOST_UNPOOLED=

# Neon project id — reported by /api/auth/config-check for diagnostics only.
# BGMISTORE_NEON_PROJECT_ID=

# ── 2. AUTHENTICATION ──────────────────────────────────────────────────────
# Clerk (Dashboard → API keys). Optional: the store signs users in with its
# own Google OAuth + PKCE flow (src/lib/google-oauth.ts). Both keys are
# validated by /api/auth/config-check so a half-configured Clerk app is
# caught before it ships.
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Google OAuth 2.0 (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=822938602122-d99qjh37o9gl4hu332ijrdjjjvum4f5p.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
# Must exactly match an Authorized redirect URI on this OAuth client.
GOOGLE_REDIRECT_URI=https://battlegroundmobilesindia.shop/auth/google/callback

# Canonical site URL — used as the OAuth redirect base when
# GOOGLE_REDIRECT_URI is omitted. No trailing slash.
# ⚠️ Paste the PLAIN URL only. Copying a rendered Markdown link gives you
#    "[https://x.com](https://x.com)", which is silently invalid.
NEXTAUTH_URL=https://battlegroundmobilesindia.shop

# Session signing key — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Role based access control
# Comma separated. These Google accounts get the full-access `owner` role.
# Extra admins / managers / moderators are added from the website itself:
# Admin Panel → Team & Roles (stored in the staff_members table — no env change
# or redeploy needed, and access can be suspended/removed instantly).
OWNER_EMAIL=manavjeph800@gmail.com

# ── 3. OTHER KEYS ──────────────────────────────────────────────────────────
# Meta (Facebook) Pixel
# Public by design — it ships inside the browser bundle. Leave it empty in any
# environment where you don't want tracking (the <MetaPixel /> component then
# renders nothing). Read by src/components/meta-pixel.tsx + src/lib/fpixel.ts.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=4056208531176598

# ── Optional: transactional email (admin password-reset OTP) ────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# OTP_FROM=

# ── Optional: Telegram instant alerts to the admin's phone ──────────────────
# New orders + new support tickets / customer replies are pushed to the
# admin's Telegram via the Bot API (HTML bold formatting, sent async after
# the response so checkout/chat is never slowed down).
# TELEGRAM_BOT_TOKEN comes from @BotFather; ADMIN_CHAT_ID is the admin's chat
# id (get it from @userinfobot). The values below are the store's live bot —
# override them per environment and never share the token publicly.
TELEGRAM_BOT_TOKEN=8870123992:AAG7TMwI04Rm35yNTDb9Ri0io1evlvqH21M
ADMIN_CHAT_ID=6109375681

# ── Optional: external BGMI UID verification API ────────────────────────────
# BGMI_UID_API_URL=
# BGMI_UID_API_KEY=

# ── Optional: serve the built-in demo catalog when the DB read fails ─────────
# Non-production only, and only after a database failure. Never set in prod.
# STORE_DEMO_CATALOG=1
