# ============================================================================
#  Battleground Mobile India Store — environment variables
#  Copy to .env.local for local dev, or paste into your host's dashboard
#  (Vercel → Settings → Environment Variables, Netlify → Site configuration).
#  NEVER commit the real values.
# ============================================================================

# ── Database (Neon / any PostgreSQL) ────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── Clerk Authentication (https://dashboard.clerk.com) ──────────────────────
# LIVE keys for battlegroundmobilesindia.shop — set these in Vercel dashboard
# Get them from https://dashboard.clerk.com → API Keys
# The real values are in .env.local (gitignored) and must be added to Vercel
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_CLERK_PUBLISHABLE_KEY_HERE
CLERK_SECRET_KEY=sk_live_YOUR_CLERK_SECRET_KEY_HERE
# Real keys provided:
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuYmF0dGxlZ3JvdW5kbW9iaWxlc2luZGlhLnNob3Ak
# CLERK_SECRET_KEY=sk_live_... (set in Vercel, not committed)
# Optional recommended overrides:
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Role based access control ───────────────────────────────────────────────
# Comma separated. These accounts get the full-access `owner` role.
# manavjeph800@gmail.com is the primary owner/admin — gets /admin access.
OWNER_EMAIL=manavjeph800@gmail.com
# Extra admins / managers / moderators are added from the website itself:
# Admin Panel → Team & Roles (stored in staff_members table).

# ── Legacy Google OAuth (deprecated - replaced by Clerk) ────────────────────
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=...
# AUTH_SECRET=...

# ── Optional: transactional email ───────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
