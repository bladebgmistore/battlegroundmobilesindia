# ============================================================================
#  Battleground Mobile India Store — environment variables
#  Copy to `.env` (or `.env.local`) for local dev, or paste into your host's
#  dashboard (Vercel → Settings → Environment Variables,
#  Netlify → Site configuration). NEVER commit the real values.
#
#  Every variable below is resolved in ONE place: `src/lib/env.ts`.
# ============================================================================

# ── 1. DATABASE — 3 separate Neon PostgreSQL databases ─────────────────────
# Use the POOLED connection string (host contains "-pooler") for each database.
# Keep the query string: ?sslmode=require&channel_binding=require

# DB1 — Primary User Accounts, Authentication, User Profiles, Roles/Permissions
DATABASE_URL_DB1="postgresql://neondb_owner:REPLACE_ME@ep-db1-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# DB2 — Store Inventory, Products, Categories, Items, and Pricing data
DATABASE_URL_DB2="postgresql://neondb_owner:REPLACE_ME@ep-db2-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# DB3 — Orders, Transactions, Payment Logs, Delivery Proofs, Referral Points
DATABASE_URL_DB3="postgresql://neondb_owner:REPLACE_ME@ep-db3-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional Neon project id — reported by /api/auth/config-check (diagnostics only).
# BGMISTORE_NEON_PROJECT_ID=

# ── 2. AUTHENTICATION ──────────────────────────────────────────────────────
# Google OAuth 2.0 (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must exactly match an Authorized redirect URI on this OAuth client.
GOOGLE_REDIRECT_URI=https://your-domain.example/auth/google/callback

# Canonical site URL — used as the OAuth redirect base when
# GOOGLE_REDIRECT_URI is omitted. No trailing slash.
NEXTAUTH_URL=https://your-domain.example

# Session signing key — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Role based access control
# Comma separated. These Google accounts get the full-access `owner` role.
OWNER_EMAIL=owner@example.com

# Optional Clerk keys — only validated by /api/auth/config-check.
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── 3. OTHER KEYS ──────────────────────────────────────────────────────────
# Meta (Facebook) Pixel — public by design. Leave empty to disable tracking.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# Optional: transactional email (admin password-reset OTP)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# OTP_FROM=

# Optional: Telegram instant alerts to the admin's phone
# TELEGRAM_BOT_TOKEN=
# ADMIN_CHAT_ID=

# Optional: external BGMI UID verification API
# BGMI_UID_API_URL=
# BGMI_UID_API_KEY=

# Optional: serve the built-in demo catalog when the DB read fails.
# Non-production only. Never set in prod.
# STORE_DEMO_CATALOG=1
